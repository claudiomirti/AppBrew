table fact_transaction
	lineageTag: dfff5c3d-3ef8-4d61-8192-ad7edd4b6cee
	sourceLineageTag: [dbo].[fact_transaction]

	measure 'Total Spend' = SUM(dim_campaign[budget_gbp])
		formatString: 0
		lineageTag: de34dcdc-2004-446e-8588-6078a31f7ba2

		changedProperty = Name

	measure Revenue = SUM(fact_transaction[amount_gbp])
		lineageTag: da683208-2c6b-440a-b1c8-941ec97acc6b

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ROAS = DIVIDE([Revenue], [Total Spend])
		lineageTag: 97abaaa3-68c7-40a9-8218-c5c7d7e2fa34

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Conversion Rate' = DIVIDE(COUNTROWS(fact_transaction), SUM(fact_impression[impression_id]))
		formatString: 0
		lineageTag: a0c69fae-9f8e-4fdd-8bee-a3b83083e920

		changedProperty = Name

