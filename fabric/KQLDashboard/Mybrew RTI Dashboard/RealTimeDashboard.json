  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "ba0e946f-b7e0-443a-851f-f2b89cba7853"
      },
      "text": "POSTransactions\r\n| summarize TotalRevenueGBP=sum(amount_gbp), Transactions=count() by store_id\r\n| order by TotalRevenueGBP desc",
      "id": "2133d9f0-274f-4244-a183-dce103f84883",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "ba0e946f-b7e0-443a-851f-f2b89cba7853"
      },
      "text": "AdImpressions\r\n| summarize Impressions=count(), Clicks=countif(clicked) by campaign_id, publisher\r\n| extend CTR=round(todouble(Clicks)/todouble(Impressions)*100.0, 2)\r\n| order by Impressions desc",
      "id": "24326869-e5c0-44f3-b655-bc4b3d4895ec",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "ba0e946f-b7e0-443a-851f-f2b89cba7853"
      },
      "text": "WeatherEvents\r\n| project EventTime = event_time, City = city, Temperature = temp_c, Condition = condition, PersonalizationTrigger = iff(temp_c < 10, \"Cold\", iff(temp_c > 25, \"Hot\", \"Mild\"))\r\n| sort by EventTime desc\r\n| take 20",
      "id": "f1d5c263-79fd-48ec-84a5-deeaa574df54",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "ba0e946f-b7e0-443a-851f-f2b89cba7853"
      },
      "text": "ROIMetrics\r\n| summarize AvgROI=round(avg(roi), 2), TotalRevenue=sum(attributed_revenue_gbp), TotalSpend=sum(total_spend_gbp) by campaign_id\r\n| extend ROAS=round(TotalRevenue/TotalSpend, 2)\r\n| order by AvgROI desc",
      "id": "4d40dcbf-4263-4082-94d7-9cd2152f4940",
      "usedVariables": []
    }
  ],
  "embeddedApps": []
}