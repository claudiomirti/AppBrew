# Eventhouse connection for the Stream Analytics page.
# Copy to `.env.local` and edit if you point the app at a different Fabric workspace.

VITE_KUSTO_CLUSTER=https://trd-t1s1uap7p3xkuvdx9s.z8.kusto.fabric.microsoft.com
VITE_KUSTO_DATABASE=mybrew_eventhouse

# SPA app registration "AppBrew Stream Analytics" — used only by deployed builds, which
# query Kusto directly from the browser. Local `npm run dev` uses your Azure CLI login
# through the Vite proxy and ignores these.
VITE_ENTRA_CLIENT_ID=b757ec5c-072a-46c9-ba6d-bd10f851900f
VITE_ENTRA_TENANT_ID=a7bb15d9-42fd-41c6-9b42-97da7d95eeb3

# Optional: disambiguate silent SSO when several accounts are signed in to the browser.
# VITE_ENTRA_LOGIN_HINT=admin@MngEnvMCAP451665.onmicrosoft.com

# Fabric data agent behind the Business Context page. Both fall back to the demo
# workspace's own ids, so only set these if you point the app at your own workspace.
# VITE_FABRIC_WORKSPACE_ID=4bf66efa-94d7-4753-a5c4-70c79358bbd6
# VITE_FABRIC_AGENT_ID=a5bd2864-b165-4782-9119-ad9d57698f58

# Microsoft Web IQ key for the WW IQ page (competitor news + sentiment).
# DEMO ONLY: this app is a static site with no backend, so whatever you put here is
# compiled into the JS bundle and is readable by anyone who opens the deployed app.
# Put the real key in `.env.local` (gitignored) and rotate it after the demo.
VITE_WEBIQ_KEY=your-web-iq-key-here
